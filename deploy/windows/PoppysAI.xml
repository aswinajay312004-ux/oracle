<?xml version="1.0" encoding="UTF-8"?>
<!--
  POPPYS AI as a Windows service, for WinSW 2.12.0 (v2 XML syntax). Decisions: docs/RESEARCH_DECISIONS.md,
  "Windows service and packaging"; operator guide: docs/RUNBOOK.md.

  WinSW is NOT in this repository. Download WinSW-x64.exe 2.12.0 (MIT licence) from
  https://github.com/winsw/winsw/releases/tag/v2.12.0 and rename it PoppysAI.exe. install-service.ps1 checks
  its SHA-256, copies it next to this file and registers the service. Do not edit this file on the laptop:
  install-service.ps1 and upgrade.ps1 copy it from the release, so a local edit is lost at the next upgrade.

  Layout (%BASE% is the folder that holds PoppysAI.exe; install-service.ps1 uses C:\ProgramData\PoppysAI):
    %BASE%\PoppysAI.exe, PoppysAI.xml   the wrapper and this file
    %BASE%\current                      junction to the active release in %BASE%\releases\<version>
    %BASE%\data                         poppys.sqlite3, uploads, backups (the only data the service writes)
    %BASE%\logs                         PoppysAI.out.log, PoppysAI.err.log, PoppysAI.wrapper.log
    %BASE%\config\.env.poppys           Oracle settings (readable by the service account and administrators only)

  install-service.ps1 rewrites the executable to %BASE%\current\python\python.exe when a release ships the
  embeddable Python instead of a .venv. Interpreter flags: -E and -s ignore PYTHON* variables and the user
  site folder; not -I, which would also drop the working folder from sys.path and break "backend.main".
  The app writes its own JSON logs (request IDs, rotation) to the data folder's logs directory, so uvicorn's
  access log stays off and no log configuration file is needed.
  (XML comments cannot contain two dashes in a row, so command-line options are not spelled out here.)
-->
<service>
  <id>PoppysAI</id>
  <name>POPPYS AI</name>
  <description>POPPYS AI order entry (http://127.0.0.1:8008): reads buyer Excel files and, after approval, saves orders to the local Oracle database.</description>

  <executable>%BASE%\current\.venv\Scripts\python.exe</executable>
  <arguments>-E -s -X utf8 -m uvicorn backend.main:app --host 127.0.0.1 --port 8008 --workers 1 --no-server-header --no-access-log --limit-concurrency 64 --timeout-graceful-shutdown 20</arguments>
  <workingdirectory>%BASE%\current</workingdirectory>
  <env name="POPPYS_DATA_DIR" value="%BASE%\data"/>

  <!-- Least privilege: no password, no network identity, write access only to %BASE%\data and %BASE%\logs. -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>

  <startmode>Automatic</startmode>
  <delayedAutoStart/>

  <!-- Restart after a crash: 10 s, then 30 s, then every 60 s; the count resets after one hour of running. -->
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>

  <!-- Stop: Ctrl+C first; uvicorn finishes open requests within 20 s; WinSW kills the process after 30 s. -->
  <stoptimeout>30sec</stoptimeout>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
