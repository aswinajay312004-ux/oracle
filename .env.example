# Actual secrets belong in .env.poppys, which is ignored by git (scripts/bootstrap_local.py writes it).
ORACLE_USER=POPPYS_APP
ORACLE_PASSWORD=
ORACLE_DSN=127.0.0.1:1521/FREEPDB1
ORACLE_OWNER=GARMENT_DEMO
# Saving is allowed only to the database on this computer: every host in ORACLE_DSN must be 127.0.0.1, localhost
# or ::1. ORACLE_ALLOWED_HOSTS replaces that list (comma-separated) - set it only for a rehearsal database the DBA
# named, never for the live Axpert database. ORACLE_DB_IDENTITY pins the database by name (CON_NAME or
# DB_UNIQUE_NAME); scripts/bootstrap_local.py writes FREEPDB1.
ORACLE_ALLOWED_HOSTS=
ORACLE_DB_IDENTITY=FREEPDB1
# Optional read-only account for Ask AI, the explorer, history and read-back (scripts/create_readonly_user.py).
ORACLE_RO_USER=
ORACLE_RO_PASSWORD=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
